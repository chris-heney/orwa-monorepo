# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
out-tsc

# Nx compile output + local testing artifacts (screenshots, dumps)
tmp

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

vite.config.*.timestamp*
vitest.config.*.timestamp*

# Environment files
.env.local
.env.*.local
# Environment files (real tokens live only on dev machines / CI)
apps/*/.env
apps/*/.env.development
apps/*/.env.production
!apps/*/.env.example

# Headless browser test artifacts
.playwright-mcp/
.cursor/hooks/state/

# Local DB dumps (never commit)
.local-dumps/

# Local machine-only secrets (never commit): WP application passwords, etc.
.local-secrets/

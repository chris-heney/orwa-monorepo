# Unified image for workspace-managed Vite apps (deps come from the monorepo root).
# Build from the monorepo root, e.g.:
#   docker build -t ghcr.io/chris-heney/orwa-monorepo/grant-map \
#     -f docker/Dockerfile.nx-app --build-arg APP=grant-map .
# Vite env vars are baked at build time; pass them as build args, e.g.:
#   --build-arg VITE_API_ENDPOINT=https://admin.orwa.org

ARG APP

FROM node:22-alpine AS build
ARG APP
ARG VITE_API_ENDPOINT
ARG VITE_API_KEY
ENV VITE_API_ENDPOINT=${VITE_API_ENDPOINT} \
    VITE_API_KEY=${VITE_API_KEY}
WORKDIR /workspace
COPY package.json package-lock.json nx.json tsconfig.base.json ./
COPY vendor-tarballs ./vendor-tarballs
RUN npm ci --no-audit --no-fund
COPY eslint.config.mjs jest.config.ts jest.preset.js ./
COPY apps/${APP} ./apps/${APP}
RUN npx nx build ${APP} --skip-nx-cache

FROM nginx:alpine
ARG APP
COPY --from=build /workspace/dist/apps/${APP} /usr/share/nginx/html
COPY apps/${APP}/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

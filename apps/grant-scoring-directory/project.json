{
  "name": "grant-scoring-directory",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/grant-scoring-directory/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/grant-scoring-directory",
        "skipTypeCheck": true
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "npm run dev",
        "cwd": "apps/grant-scoring-directory"
      },
      "configurations": {
        "development": {
          "command": "npm run dev",
          "cwd": "apps/grant-scoring-directory"
        },
        "production": {
          "command": "npm run preview",
          "cwd": "apps/grant-scoring-directory"
        }
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": [
        "{options.reportsDirectory}"
      ],
      "options": {
        "reportsDirectory": "../../coverage/apps/grant-scoring-directory"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "docker build -t ghcr.io/chris-heney/orwa-monorepo/grant-scoring-directory:latest -f docker/Dockerfile.nx-app --build-arg APP=grant-scoring-directory --build-arg VITE_API_ENDPOINT=$VITE_API_ENDPOINT --build-arg VITE_API_KEY=$VITE_API_KEY .",
        "cwd": "{workspaceRoot}"
      }
    },
    "docker-push": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "docker-build"
      ],
      "options": {
        "command": "docker push ghcr.io/chris-heney/orwa-monorepo/grant-scoring-directory:latest"
      }
    }
  }
}

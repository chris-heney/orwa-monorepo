# Example environment variables for grant-scoring-directory
# Copy this file to .env.development and fill in your values.
# The endpoint must include the /api suffix.
# Production path: https://orwa.org/application-search/
VITE_API_ENDPOINT=https://admin.orwa.org/api
VITE_API_KEY=your-api-key-here
VITE_BASE_URI=/application-search

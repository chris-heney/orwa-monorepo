# Example environment variables for grant-map
# Copy this file to .env / .env.development and fill in your values
# NOTE: the app appends resource paths directly, so the /api suffix is required
VITE_API_ENDPOINT=http://localhost:1337/api
VITE_API_KEY=your-api-key-here
VITE_MAPBOX_TOKEN=your-mapbox-token-here
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
VITE_ORWA_GAPP_ENDPOINT=https://orwa.org/wp-json/strapi/v1/grant-currentApplication-finals
VITE_CENTER_LAT=35
VITE_CENTER_LNG=-98

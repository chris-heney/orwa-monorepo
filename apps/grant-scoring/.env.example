# Example environment variables for grant-scoring (GApp Eval)
# Copy to .env.development / .env.production and fill in values.
# Endpoint must include the /api suffix.
# Production path: https://orwa.org/grant-administration/
VITE_API_ENDPOINT=https://admin.orwa.org/api
VITE_API_KEY=your-api-key-here
VITE_BASE_URI=/grant-administration

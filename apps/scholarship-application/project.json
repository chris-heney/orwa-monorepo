{
  "name": "scholarship-application",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/scholarship-application/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/scholarship-application",
        "skipTypeCheck": true
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "npm run dev",
        "cwd": "apps/scholarship-application"
      },
      "configurations": {
        "development": {
          "command": "npm run dev",
          "cwd": "apps/scholarship-application"
        },
        "production": {
          "command": "npm run preview",
          "cwd": "apps/scholarship-application"
        }
      }
    },
    "preview": {
      "executor": "@nx/vite:preview-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "scholarship-application:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "scholarship-application:build:development"
        },
        "production": {
          "buildTarget": "scholarship-application:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": [
        "{options.reportsDirectory}"
      ],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "../../coverage/apps/scholarship-application"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "apps/scholarship-application/**/*.{ts,tsx,js,jsx}"
        ]
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "docker build -t ghcr.io/chris-heney/orwa-monorepo/scholarship-application:latest -f docker/Dockerfile.nx-app --build-arg APP=scholarship-application --build-arg VITE_API_ENDPOINT=$VITE_API_ENDPOINT --build-arg VITE_API_KEY=$VITE_API_KEY .",
        "cwd": "{workspaceRoot}"
      }
    },
    "docker-push": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "docker-build"
      ],
      "options": {
        "command": "docker push ghcr.io/chris-heney/orwa-monorepo/scholarship-application:latest"
      }
    }
  }
}

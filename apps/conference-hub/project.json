{
  "name": "conference-hub",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/conference-hub/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/conference-hub",
        "skipTypeCheck": true
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "npm run dev",
        "cwd": "apps/conference-hub"
      },
      "configurations": {
        "development": {
          "command": "npm run dev",
          "cwd": "apps/conference-hub"
        },
        "production": {
          "command": "npm run preview",
          "cwd": "apps/conference-hub"
        }
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "../../coverage/apps/conference-hub"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "docker build -t ghcr.io/chris-heney/orwa-monorepo/conference-hub:latest -f docker/Dockerfile.nx-app --build-arg APP=conference-hub --build-arg VITE_API_ENDPOINT=$VITE_API_ENDPOINT --build-arg VITE_API_KEY=$VITE_API_KEY .",
        "cwd": "{workspaceRoot}"
      }
    },
    "docker-push": {
      "executor": "nx:run-commands",
      "dependsOn": ["docker-build"],
      "options": {
        "command": "docker push ghcr.io/chris-heney/orwa-monorepo/conference-hub:latest"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./deploy.sh",
        "cwd": "apps/conference-hub"
      }
    }
  }
}

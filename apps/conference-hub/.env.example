# Copy to .env.development / .env.production as needed.
# VITE_API_ENDPOINT must end with /api (same convention as conference-registration).

# Development (local Strapi — apps/strapi uses PORT=13370)
VITE_API_ENDPOINT=http://localhost:13370/api
VITE_API_KEY=your-local-api-key

# Production
# VITE_API_ENDPOINT=https://admin.orwa.org/api
# VITE_API_KEY=your-production-api-key

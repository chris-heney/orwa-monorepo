{
    "name": "@react-admin/ra-navigation",
    "version": "4.8.0",
    "description": "Navigation components for react-admin",
    "files": [
        "*.md",
        "lib",
        "esm",
        "src"
    ],
    "author": "Marmelab <contact@marmelab.com> (https://marmelab.com/)",
    "main": "lib/src/index",
    "module": "esm/src/index.js",
    "types": "esm/src/index.d.ts",
    "scripts": {
        "build": "yarn run build-cjs && yarn run build-esm",
        "build-cjs": "rimraf ./lib && tsc",
        "build-esm": "rimraf ./esm && tsc --outDir esm --module es2015"
    },
    "devDependencies": {
        "ra-data-fakerest": "^4.14.0",
        "ra-i18n-polyglot": "^4.14.0",
        "ra-language-english": "^4.14.0",
        "react": "^17.0.2",
        "react-admin": "^4.14.0",
        "react-dom": "^17.0.2",
        "react-router-dom": "^6.1.0",
        "rimraf": "^3.0.2",
        "stylis": "^4.1.1",
        "stylis-plugin-rtl": "^2.1.1",
        "typescript": "^5.1.3"
    },
    "peerDependencies": {
        "inflection": "^1.12.0",
        "lodash": "^4.17.20",
        "react": "^16.9.0 || ^17.0.0 || ^18.0.0",
        "react-admin": "^4.10.6",
        "react-dom": "^16.9.0 || ^17.0.0 || ^18.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/react-admin/ra-enterprise.git"
    }

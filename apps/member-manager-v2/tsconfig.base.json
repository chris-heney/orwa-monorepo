{
  "compileOnSave": false,
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],

    /* Modules */
    "module": "ESNext",
    "moduleResolution": "node",
    "rootDir": ".",

    /* Emit */
    "sourceMap": true,
    "declaration": false,

    /* Interop Constraints */
    "importHelpers": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    /* Type Checking */
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,

    /* Path Mapping */
    "baseUrl": "."
  },
  "exclude": ["node_modules", "tmp"]
} 
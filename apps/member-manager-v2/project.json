{
    "name": "member-manager-v2",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/member-manager-v2/src",
    "projectType": "application",
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "outputs": [
                "{workspaceRoot}/apps/member-manager-v2/dist",
                "{workspaceRoot}/apps/member-manager-v2/build"
            ],
            "dependsOn": ["^build", "ensure:deps"],
            "options": {
                "command": "NODE_OPTIONS=--max_old_space_size=4096 vite build",
                "cwd": "apps/member-manager-v2"
            },
            "configurations": {
                "production": {
                    "command": "NODE_OPTIONS=--max_old_space_size=4096 vite build --mode production"
                },
                "development": {
                    "command": "NODE_OPTIONS=--max_old_space_size=4096 vite build --mode development"
                }
            }
        },
        "docker:build": {
            "executor": "nx:run-commands",
            "options": {
                "command": "docker build --no-cache --target production -t ghcr.io/ciwebgroup/member-manager-v2:latest -f apps/member-manager-v2/Dockerfile .",
                "cwd": "{workspaceRoot}"
            }
        },
        "docker:build:multi": {
            "executor": "nx:run-commands",
            "options": {
                "command": "docker buildx build --platform linux/amd64,linux/arm64 --build-arg APP_NAME=member-manager-v2 --target frontend-runtime -f docker/optimized.Dockerfile -t ghcr.io/ciwebgroup/member-manager-v2:latest . --push",
                "cwd": "{workspaceRoot}"
            }
        },
        "deploy": {
            "executor": "nx:run-commands",
            "dependsOn": ["docker:build"],
            "options": {
                "command": "docker push ghcr.io/ciwebgroup/member-manager-v2:latest"
            }
        },
        "docker:build:local": {
            "executor": "nx:run-commands",
            "options": {
                "command": "docker build --no-cache --target production -t ghcr.io/ciwebgroup/member-manager-v2:latest -f apps/member-manager-v2/Dockerfile .",
                "cwd": "{workspaceRoot}"
            }
        },
        "ensure:deps": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm install",
                "cwd": "apps/member-manager-v2"
            }
        },
        "serve": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run dev",
                "cwd": "apps/member-manager-v2"
            }
        },
        "stop": {
            "executor": "nx:run-commands",
            "options": {
                "command": "docker compose down",
                "cwd": "apps/member-manager-v2"
            }
        },
        "preview": {
            "executor": "nx:run-commands",
            "dependsOn": ["build"],
            "options": {
                "command": "vite preview",
                "cwd": "apps/member-manager-v2"
            }
        },
        "docker": {
            "executor": "nx:run-commands",
            "options": {
                "command": "docker compose up -d",
                "cwd": "apps/member-manager-v2"
            }
        },
        "docker-down": {
            "executor": "nx:run-commands",
            "options": {
                "command": "docker compose down",
                "cwd": "apps/member-manager-v2"
            }
        },
        "docker:restart": {
            "executor": "nx:run-commands",
            "options": {
                "command": "docker compose down && docker compose up -d",
                "cwd": "apps/member-manager-v2"
            }
        },
        "lint": {
            "executor": "@nx/eslint:eslint",
            "outputs": ["{options.outputFile}"],
            "options": {
                "lintFilePatterns": ["apps/member-manager-v2/**/*.{ts,tsx,js,jsx}"]
            }
        },
        "test": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run test",
                "cwd": "apps/member-manager-v2"
            }
        },
        "fix": {
            "executor": "nx:run-commands",
            "options": {
                "command": "rm -fr node_modules && npm i --legacy-peer-deps",
                "cwd": "apps/member-manager-v2"
            }
        }
    },
    "serve": {
        "executor": "nx:run-commands",
        "options": {
            "command": "npm run dev",
            "cwd": "apps/member-manager-v2"
        }
    },
    "tags": []
}

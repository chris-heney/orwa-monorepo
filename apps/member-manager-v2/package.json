{
    "name": "synapse",
    "version": "5.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "preview": "vite preview",
        "analyze": "source-map-explorer 'build/static/js/*.js'",
        "build": "NODE_OPTIONS=--max_old_space_size=4096 vite build",
        "lint": "eslint --ext .js,.ts,.tsx \"./src/**/*.{js,ts,tsx}\"",
        "lint:fix": "eslint --ext .js,.ts,.tsx \"./src/**/*.{js,ts,tsx}\" --fix",
        "prettier": "prettier --config ./.prettierrc.js --write --list-different \"./src/**/*.{js,json,ts,tsx,css,md}\"",
        "e2e-dev": "cypress open",
        "e2e-run": "cypress run --browser chrome --headless",
        "e2e-serve": "serve -c ../cypress/serve.json -l 3000 build",
        "e2e": "start-server-and-test e2e-serve http://localhost:3000 e2e-run",
        "type-check": "tsc",
        "dev": "vite"
    },
    "dependencies": {
        "@lexical/code": "^0.17.0",
        "@lexical/hashtag": "^0.17.0",
        "@lexical/html": "^0.17.0",
        "@lexical/link": "^0.17.0",
        "@lexical/list": "^0.17.0",
        "@lexical/markdown": "^0.17.0",
        "@lexical/react": "^0.17.0",
        "@lexical/rich-text": "^0.17.0",
        "@lexical/table": "^0.17.0",
        "lexical": "^0.17.0",
        "@mui/icons-material": "^5.16.7",
        "@mui/material": "^5.16.7",
        "@mui/x-date-pickers": "^6.20.2",
        "@fullcalendar/rrule": "^6.1.9",
        "@react-admin/ra-audit-log": "^5.0.0",
        "@react-admin/ra-calendar": "^6.0.0",
        "@react-admin/ra-editable-datagrid": "^5.0.0",
        "@react-admin/ra-enterprise": "^12.0.0",
        "@react-admin/ra-form-layout": "^5.0.0",
        "@react-admin/ra-history": "^5.0.0",
        "@react-admin/ra-markdown": "^5.0.0",
        "@react-admin/ra-navigation": "^5.0.0",
        "@react-admin/ra-realtime": "^5.0.0",
        "@react-admin/ra-relationships": "^5.0.0",
        "@react-admin/ra-search": "^5.0.0",
        "@react-admin/ra-tour": "^5.0.0",
        "@react-admin/ra-tree": "^5.0.0",
        "@tanstack/react-query-devtools": "^5.8.4",
        "@tinymce/tinymce-react": "^5.1.1",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@types/react-beautiful-dnd": "^13.1.8",
        "@types/recharts": "^1.8.10",
        "data-generator-retail": "^5.0.0",
        "fakerest": "^4.0.1",
        "fetch-mock": "^11.1.5",
        "postcss-normalize": "^10.0.1",
        "ra-data-simple-rest": "^5.0.0",
        "ra-i18n-polyglot": "^5.0.0",
        "ra-input-rich-text": "^5.0.0",
        "ra-language-english": "^5.0.0",
        "ra-language-french": "^5.0.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-admin": "^5.0.0",
        "react-beautiful-dnd": "^13.1.1",
        "react-dropzone": "^14.3.8",
        "recharts": "^2.1.5",
        "rrule": "^2.7.2",
        "tinymce": "^7.5.1"
    },
    "homepage": ".",
    "browserslist": [
        ">0.2%",
        "not dead",
        "not ie <= 10",
        "not op_mini all"

{
    "extends": ["./tsconfig.base.json", "./tsconfig.paths.json"],
    "compilerOptions": {
        /* Language and Environment */
        "target": "ESNext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "useDefineForClassFields": true,

        /* Modules */
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "allowSyntheticDefaultImports": true,

        /* Emit */
        "noEmit": true,

        /* Interop Constraints */
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,

        /* Type Checking */
        "strict": false,
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "typeRoots": ["../../node_modules/@types", "node_modules/@types"],

        /* Root directory */
        "rootDir": "../..",

        /* Path Mapping */
        "paths": {
            "@ci-connect/types": ["../../libs/types/src/index.ts"],
            "@ci-connect/utils": ["../../libs/utils/src/index.ts"],
            "@ci-connect/ui-components": ["../../libs/ui-components/src/index.ts"],
            "@ci-connect/api-client": ["../../libs/api-client/src/index.ts"],
            "@ci-connect/database": ["../../libs/database/src/index.ts"],
            "@ci-connect/messaging": ["../../libs/messaging/src/index.ts"],
            "@ci-connect/prisma": ["../../libs/prisma/index.ts"],
            "@ci-connect/storage": ["../../libs/storage/src/index.ts"]
        }
    },
    "include": ["src"],
    "references": [
        {
            "path": "./tsconfig.node.json"
        }
    ]
}

# Server
HOST=0.0.0.0
PORT=1337
URL=http://localhost:1337
PUBLIC_URL=http://localhost:1337
BASE_URL=http://localhost:1337
STRAPI_API_ENDPOINT=http://localhost:1337
STRAPI_ADMIN_BACKEND_URL=http://localhost:1337

# Secrets (generate with `openssl rand -base64 32`)
APP_KEYS=toBeModified1,toBeModified2
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified

# Database (Strapi 5 mysql dialect uses the mysql2 driver)
DATABASE_CLIENT=mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi

# Email (Brevo)
BREVO_API_KEY=not-set

# Public URL of the grant application frontend (used in edit-link emails)
GRANT_APP_URL=http://localhost:4200

NODE_ENV=development

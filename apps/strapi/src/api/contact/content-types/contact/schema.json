{
  "kind": "collectionType",
  "collectionName": "contacts",
  "info": {
    "singularName": "contact",
    "pluralName": "contacts",
    "displayName": "Contact",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "first": {
      "type": "string",
      "required": false
    },
    "last": {
      "type": "string"
    },
    "email": {
      "type": "email",
      "required": false,
      "unique": true
    },
    "phone": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "address_mailing_line1": {
      "type": "string"
    },
    "address_mailing_line2": {
      "type": "string"
    },
    "address_mailing_city": {
      "type": "string"
    },
    "address_mailing_state": {
      "type": "enumeration",
      "enum": [
        "Alabama",
        "Alaska",
        "Arizona",
        "Arkansas",
        "California",
        "Colorado",
        "Connecticut",
        "Delaware",
        "Florida",
        "Georgia",
        "Hawaii",
        "Idaho",
        "Illinois",
        "Indiana",
        "Iowa",
        "Kansas",
        "Kentucky",
        "Louisiana",
        "Maine",
        "Maryland",
        "Massachusetts",
        "Michigan",
        "Minnesota",
        "Mississippi",
        "Missouri",
        "Montana",
        "Nebraska",
        "Nevada",
        "New Hampshire",
        "New Jersey",
        "New Mexico",
        "New York",
        "North Carolina",
        "North Dakota",
        "Ohio",
        "Oklahoma",
        "Oregon",
        "Pennsylvania",
        "Rhode Island",
        "South Carolina",
        "South Dakota",
        "Tennessee",
        "Texas",
        "Utah",
        "Vermont",
        "Virginia",
        "Washington",
        "West Virginia",
        "Wisconsin",
        "Wyoming"
      ],
      "default": "Oklahoma"
    },
    "address_mailing_zip": {
      "type": "string",
      "maxLength": 10
    },
    "contact_type": {
      "type": "enumeration",
      "enum": [
        "associate",
        "watersystem",
        "instructor",
        "staff",
        "administrator"
      ]
    },
    "directory_opt_out": {
      "type": "boolean",
      "default": false
    },
    "license": {
      "type": "string"
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "avatar": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "badges": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::contact-badge.contact-badge"
    },
    "scholarship_applicant": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::scholarship-application.scholarship-application",
      "mappedBy": "contact"
    },
    "award_nominations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::award-nomination.award-nomination",
      "mappedBy": "contact"
    }
  }
}

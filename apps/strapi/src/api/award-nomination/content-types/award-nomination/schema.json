{
  "kind": "collectionType",
  "collectionName": "award_nominations",
  "info": {
    "singularName": "award-nomination",
    "pluralName": "award-nominations",
    "displayName": "Award Nomination",
    "description": "ORWA Awards Nomination submissions"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "nomination_status": {
      "type": "enumeration",
      "required": true,
      "default": "Submitted",
      "enum": [
        "Draft",
        "Submitted",
        "Under Review",
        "Winner",
        "Runner Up",
        "Not Selected"
      ]
    },
    "submission_date": {
      "type": "datetime"
    },
    "review_notes": {
      "type": "text"
    },
    "award_year": {
      "type": "integer",
      "required": true
    },
    "nominee_name": {
      "type": "string",
      "required": true
    },
    "system_name": {
      "type": "string",
      "required": true
    },
    "award_name_printed": {
      "type": "string"
    },
    "watersystem": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::watersystem.watersystem",
      "inversedBy": "award_nominations"
    },
    "county": {
      "type": "string",
      "required": true
    },
    "address": {
      "type": "string",
      "required": true
    },
    "city": {
      "type": "string",
      "required": true
    },
    "state": {
      "type": "string",
      "default": "OK",
      "required": true
    },
    "zip": {
      "type": "string",
      "required": true
    },
    "daytime_phone": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "nominator_first_name": {
      "type": "string"
    },
    "nominator_last_name": {
      "type": "string"
    },
    "nominator_address": {
      "type": "string"
    },
    "nominator_address_2": {
      "type": "string"
    },
    "nominator_city": {
      "type": "string"
    },
    "nominator_state": {
      "type": "string"
    },
    "nominator_zip": {
      "type": "string"
    },
    "nominator_country": {
      "type": "string",
      "default": "United States"
    },
    "nominator_phone": {
      "type": "string"
    },
    "nominator_email": {
      "type": "email"
    },
    "operation_start_date": {
      "type": "date"
    },
    "employment_date": {
      "type": "date"
    },
    "current_members": {
      "type": "integer"
    },
    "beginning_members": {
      "type": "integer"
    },
    "clerical_employees": {
      "type": "integer"
    },
    "operation_maintenance_employees": {
      "type": "integer"
    },
    "management_employees": {
      "type": "integer"
    },
    "justification": {
      "type": "text",
      "required": true
    },
    "award_type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "System of the Year",
        "Water/Wastewater System of the Year",
        "Excellence in Operations",
        "Excellence in Management",
        "Excellence in Office Operations"
      ]
    },
    "biography_method": {
      "type": "enumeration",
      "enum": [
        "Copy/Paste or Type Biography",
        "Upload Biography"
      ]
    },
    "biography_text": {
      "type": "text"
    },
    "biography_file": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files",
        "images"
      ]
    },
    "photographs": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "board_list_method": {
      "type": "enumeration",
      "enum": [
        "File You Upload",
        "Keyed In List"
      ]
    },
    "board_list_file": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files",
        "images"
      ]
    },
    "board_members": {
      "type": "json"
    },
    "contact": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::contact.contact",
      "inversedBy": "award_nominations"
    },
    "supporting_documents": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "files",
        "images"
      ]
    },
    "nomination_pdf": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    }
  }
}

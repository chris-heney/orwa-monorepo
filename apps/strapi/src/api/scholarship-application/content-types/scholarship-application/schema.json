{
  "kind": "collectionType",
  "collectionName": "scholarship_applications",
  "info": {
    "singularName": "scholarship-application",
    "pluralName": "scholarship-applications",
    "displayName": "Scholarship Application"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "contact": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::contact.contact",
      "mappedBy": "scholarship_applicant"
    },
    "watersystem": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::watersystem.watersystem",
      "inversedBy": "scholarship_applications"
    },
    "application_status": {
      "type": "enumeration",
      "default": "Draft",
      "enum": [
        "Draft",
        "Submitted",
        "Under Review",
        "Approved",
        "Denied"
      ]
    },
    "submission_date": {
      "type": "datetime"
    },
    "review_notes": {
      "type": "text"
    },
    "applicant_first_name": {
      "type": "string",
      "required": true
    },
    "applicant_middle_name": {
      "type": "string"
    },
    "applicant_last_name": {
      "type": "string",
      "required": true
    },
    "applicant_phone": {
      "type": "string",
      "required": true
    },
    "applicant_email": {
      "type": "email",
      "required": true
    },
    "applicant_street": {
      "type": "string",
      "required": true
    },
    "applicant_city": {
      "type": "string",
      "required": true
    },
    "applicant_state": {
      "type": "string",
      "required": true
    },
    "applicant_zip": {
      "type": "string",
      "required": true
    },
    "system_name": {
      "type": "string",
      "required": true
    },
    "relationship": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Self",
        "DependentChild",
        "DependentGrandchild"
      ]
    },
    "eligible_participant_name": {
      "type": "component",
      "component": "scholarship.eligible-participant-name",
      "repeatable": false
    },
    "eligible_participant_title": {
      "type": "string",
      "required": true
    },
    "eligible_participant_phone": {
      "type": "string",
      "required": true
    },
    "eligible_participant_email": {
      "type": "email",
      "required": true
    },
    "eligible_participant_address": {
      "type": "component",
      "component": "scholarship.address",
      "repeatable": false
    },
    "school_name": {
      "type": "string",
      "required": true
    },
    "graduation_date": {
      "type": "date",
      "required": true
    },
    "school_address": {
      "type": "component",
      "component": "scholarship.address",
      "repeatable": false
    },
    "gpa": {
      "type": "decimal",
      "required": true,
      "min": 0,
      "max": 4
    },
    "sat_score": {
      "type": "integer",
      "required": true,
      "min": 400,
      "max": 1600
    },
    "act_score": {
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 36
    },
    "transcript": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "test_scores": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "files"
      ]
    },
    "first_year": {
      "type": "string",
      "required": true
    },
    "credits_completed": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "credits_required": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "college_gpa": {
      "type": "decimal",
      "required": true,
      "min": 0,
      "max": 4
    },
    "education_type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "FourYearCollege",
        "TwoYearCollege",
        "VocationalSchool"
      ]
    },
    "major": {
      "type": "string"
    },
    "awards": {
      "type": "text"
    },
    "recommender1_name": {
      "type": "component",
      "component": "scholarship.recommender-name",
      "repeatable": false
    },
    "recommender1_email": {
      "type": "email",
      "required": true
    },
    "recommender1_phone": {
      "type": "string",
      "required": true
    },
    "recommendation_letter_1": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "files"
      ]
    },
    "recommender2_name": {
      "type": "component",
      "component": "scholarship.recommender-name",
      "repeatable": false
    },
    "recommender2_email": {
      "type": "email",
      "required": true
    },
    "recommender2_phone": {
      "type": "string",
      "required": true
    },
    "recommendation_letter_2": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "files"
      ]
    },
    "financial1_institution": {
      "type": "string"
    },
    "financial1_amount": {
      "type": "decimal",
      "min": 0
    },
    "financial2_institution": {
      "type": "string"
    },
    "financial2_amount": {
      "type": "decimal",
      "min": 0
    },
    "essay": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "files"
      ]
    },
    "biography": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "files"
      ]
    },
    "photograph": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "age_confirm": {
      "type": "string",
      "required": true
    },
    "applicant_certification": {
      "type": "boolean",
      "required": true
    },
    "applicant_certification_date": {
      "type": "date",
      "required": true
    },
    "guardian_name": {
      "type": "component",
      "component": "scholarship.guardian-name",
      "repeatable": false
    },
    "guardian_certification": {
      "type": "boolean"
    },
    "guardian_certification_date": {
      "type": "date"
    },
    "applicant_pdf": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}

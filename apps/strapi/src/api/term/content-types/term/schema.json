{
  "kind": "collectionType",
  "collectionName": "terms",
  "info": {
    "singularName": "term",
    "pluralName": "terms",
    "displayName": "Term",
    "description": "Scroll-to-agree legal terms documents, scoped by identifier tags"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "identifiers": {
      "type": "json",
      "required": true,
      "default": []
    },
    "content": {
      "type": "richtext",
      "required": true
    }
  }
}

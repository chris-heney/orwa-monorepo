{
  "kind": "collectionType",
  "collectionName": "grant_payouts",
  "info": {
    "singularName": "grant-payout",
    "pluralName": "grant-payouts",
    "displayName": "Grant Payout",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "amount": {
      "type": "decimal"
    },
    "transaction_date": {
      "type": "date"
    },
    "application": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::grant-application-final.grant-application-final",
      "inversedBy": "payouts"
    },
    "grant": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::grant.grant"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "Requested",
        "Approved",
        "Denied",
        "Paid",
        "Paid in Full"
      ]
    },
    "supporting_documents": {
      "type": "text"
    },
    "date_approved": {
      "type": "date"
    },
    "comments": {
      "type": "text"
    },
    "payout_status": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::payout-status.payout-status"
    },
    "project_type": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::project-type.project-type"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "Administrative",
        "Reimbursement"
      ]
    },
    "source": {
      "type": "enumeration",
      "enum": [
        "Admin",
        "Applicant Portal"
      ],
      "default": "Admin"
    },
    "invoices": {
      "type": "component",
      "repeatable": true,
      "component": "grant.reimbursement-invoice"
    },
    "invoice_total": {
      "type": "decimal"
    },
    "requester_name": {
      "type": "string"
    },
    "requester_title": {
      "type": "string"
    },
    "requester_email": {
      "type": "email"
    },
    "requester_phone": {
      "type": "string"
    },
    "requester_signature": {
      "type": "text"
    },
    "certified": {
      "type": "boolean",
      "default": false
    },
    "applicant_notes": {
      "type": "text"
    },
    "paid_invoices": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "proof_of_payment": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "project_photos": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "photos_not_applicable": {
      "type": "boolean",
      "default": false
    },
    "portal_submission_id": {
      "type": "string",
      "private": true
    }
  }
}

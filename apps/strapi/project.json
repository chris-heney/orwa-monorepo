{
  "name": "strapi",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/strapi/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "npm run build",
        "cwd": "apps/strapi"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run develop",
        "cwd": "apps/strapi"
      }
    },
    "serve:mysql": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose up -d mysql",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "nx:noop"
    },
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm install",
        "cwd": "apps/strapi"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -t ghcr.io/chris-heney/orwa-monorepo/strapi:latest -f apps/strapi/Dockerfile apps/strapi",
        "cwd": "{workspaceRoot}"
      }
    },
    "docker-push": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "docker-build"
      ],
      "options": {
        "command": "docker push ghcr.io/chris-heney/orwa-monorepo/strapi:latest"
      }
    }
  }
}
